rules_version = '2';

// Every file lives under the teacher's uid, so ownership is checked from the path alone
// (no Firestore lookups: cheaper and no cross-service permission needed).
// Students never read these files: their follow-up session carries the text they need.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function smallImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The blank exam and the optional answer-key copy, as the teacher uploaded them.
    match /uploads/{uid}/{examId}/{file} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    match /masters/{uid}/{examId}/{file} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && smallImage();
    }
    match /captures/{uid}/{examId}/{file} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && smallImage();
    }
    // Written by the grading worker (admin credentials).
    match /aligned/{uid}/{examId}/{subId}/{file} {
      allow read, delete: if isOwner(uid);
    }
  }
}
