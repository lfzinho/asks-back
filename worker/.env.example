# Copy to .env (git-ignored) and fill in. `uv run python -m asksback ...` reads it automatically.

# Models through OpenRouter (--model openrouter): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model that reads images. Default: nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Only for --model claude (paid)
# ANTHROPIC_API_KEY=
